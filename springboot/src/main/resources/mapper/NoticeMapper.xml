<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dao.NoticeDao"><!--也可以在Dao中写-->

    <select id="findBySearch" resultType="com.example.entity.Notice">
        select * from notice
        <where>
            <if test="params != null and params.noticeName != null and params.noticeName != ''">
                and noticeName like concat('%',#{ params.noticeName },'%')
            </if>
        </where>
        order by time desc
    </select>

</mapper>